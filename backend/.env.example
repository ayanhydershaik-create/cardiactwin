# Backend environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# ── Neon Lakebase Postgres ────────────────────────────────────────────────────
# Pooled URL — for all runtime application traffic (FastAPI / SQLAlchemy)
DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<pooler-host>/neondb?channel_binding=require&sslmode=require
# Direct URL — for schema migrations / DDL (create_all, pg_dump)
DATABASE_URL_UNPOOLED=postgresql+psycopg://neondb_owner:<password>@<direct-host>/neondb?channel_binding=require&sslmode=require

# ── Neon Branch ───────────────────────────────────────────────────────────────
NEON_BRANCH=production
NEON_BRANCH_ID=

# ── Neon Auth ─────────────────────────────────────────────────────────────────
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# ── Neon Realtime ─────────────────────────────────────────────────────────────
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# ── Neon Functions ────────────────────────────────────────────────────────────
NEON_FUNCTION_HOST_SUFFIX=

# ── Gemini API Keys (obtain from https://aistudio.google.com) ─────────────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

