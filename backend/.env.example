# Backend environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# PostgreSQL connection string (local Docker or managed cloud like Neon)
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

# Gemini API Keys (obtain from https://aistudio.google.com)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
